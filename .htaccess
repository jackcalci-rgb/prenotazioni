DirectoryIndex index.html
<FilesMatch "^(config\.php|db\.php|push\.php|mailing\.php|.*\.(json|log|lock|tmp|pos))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# app staff: manifest e service worker
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<Files "sw.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</Files>
